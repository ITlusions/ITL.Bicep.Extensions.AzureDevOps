FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS build
COPY pyproject.toml .
RUN pip install --no-cache-dir hatchling ; \
    pip install --no-cache-dir "fastapi>=0.115" "uvicorn[standard]>=0.30" "httpx>=0.27" "pydantic>=2.7"

FROM base AS final
COPY --from=build /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=build /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY src/ /app/src/

# ADO_PAT must be injected at runtime — never bake credentials into the image
ENV PYTHONPATH=/app/src
EXPOSE 8080

CMD ["uvicorn", "itl_bicep_ext_azuredevops.app:app", "--host", "0.0.0.0", "--port", "8080"]
